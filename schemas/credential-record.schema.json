{
  "$defs": {
    "CredentialStoreBackend": {
      "enum": [
        "os",
        "file"
      ],
      "title": "CredentialStoreBackend",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "凭据的可展示摘要：永不携带明文，只回 last4 + updated_at + 存储后端。",
  "properties": {
    "key_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Key Id",
      "type": "string"
    },
    "last4": {
      "maxLength": 4,
      "minLength": 0,
      "title": "Last4",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "backend": {
      "$ref": "#/$defs/CredentialStoreBackend",
      "default": "file"
    }
  },
  "required": [
    "key_id",
    "last4"
  ],
  "title": "CredentialRecord",
  "type": "object",
  "$id": "https://investment-steward.local/schemas/credential-record/1.0"
}
