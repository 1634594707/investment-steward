{
  "$defs": {
    "ActionMode": {
      "enum": [
        "observe",
        "research",
        "review_plan",
        "no_action"
      ],
      "title": "ActionMode",
      "type": "string"
    },
    "JevRouteDecision": {
      "additionalProperties": false,
      "description": "JV07：行动模式预判路由的结论（**只描述「跑了哪条链路」，不描述结论本身**）。\n\n**硬约束**：它**永不改写**同一条 `AgentResponse.action_mode`。预判说的是「这次提问该不该\n花一次完整研究调用」，`action_mode` 是作答方（模型经 `response_gate` / 本地确定性引擎）\n按证据账本给出的结论——两者不一致是**正常且可能**的，如实并陈，不互相覆盖。",
      "properties": {
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "mode_label": {
          "default": "未取得预判",
          "title": "Mode Label",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "probabilities": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Probabilities",
          "type": "object"
        },
        "bypassed_model": {
          "default": false,
          "title": "Bypassed Model",
          "type": "boolean"
        },
        "route_state": {
          "default": "unannotated",
          "title": "Route State",
          "type": "string"
        },
        "question_id": {
          "default": "",
          "title": "Question Id",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "JevRouteDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "response_id": {
      "format": "uuid",
      "title": "Response Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "user_id": {
      "format": "uuid",
      "title": "User Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "user_question": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "User Question",
      "type": "string"
    },
    "context_snapshot_refs": {
      "items": {
        "type": "string"
      },
      "title": "Context Snapshot Refs",
      "type": "array"
    },
    "summary": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "reasoning_outline": {
      "items": {
        "type": "string"
      },
      "title": "Reasoning Outline",
      "type": "array"
    },
    "confidence_description": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Confidence Description",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "supporting_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Supporting Refs",
      "type": "array"
    },
    "contradicting_refs": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Contradicting Refs",
      "type": "array"
    },
    "missing_information": {
      "items": {
        "type": "string"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "freshness_warning": {
      "items": {
        "type": "string"
      },
      "title": "Freshness Warning",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "action_mode": {
      "$ref": "#/$defs/ActionMode"
    },
    "supported_actions": {
      "items": {
        "type": "string"
      },
      "title": "Supported Actions",
      "type": "array"
    },
    "learning_link": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Learning Link"
    },
    "suggested_activity": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggested Activity"
    },
    "user_confirmation_required": {
      "default": false,
      "title": "User Confirmation Required",
      "type": "boolean"
    },
    "proposed_changes": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Changes"
    },
    "model_provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Provider"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "prompt_policy_version": {
      "default": "1.0",
      "title": "Prompt Policy Version",
      "type": "string"
    },
    "plugin_runs": {
      "items": {
        "type": "string"
      },
      "title": "Plugin Runs",
      "type": "array"
    },
    "tool_calls": {
      "items": {
        "type": "string"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "audit_refs": {
      "items": {
        "type": "string"
      },
      "title": "Audit Refs",
      "type": "array"
    },
    "jev_route": {
      "anyOf": [
        {
          "$ref": "#/$defs/JevRouteDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "response_id",
    "run_id",
    "user_id",
    "user_question",
    "summary",
    "confidence_description",
    "action_mode"
  ],
  "title": "AgentResponse",
  "type": "object",
  "$id": "https://investment-steward.local/schemas/agent-response/1.0"
}
