{
  "$defs": {
    "PluginInstallationState": {
      "enum": [
        "available",
        "installed",
        "enabled",
        "disabled",
        "revoked"
      ],
      "title": "PluginInstallationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plugin_id": {
      "title": "Plugin Id",
      "type": "string"
    },
    "release_version": {
      "title": "Release Version",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/PluginInstallationState"
    },
    "granted_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Granted Capabilities",
      "type": "array"
    },
    "artifact_sha256": {
      "title": "Artifact Sha256",
      "type": "string"
    },
    "source": {
      "default": "official-static-registry",
      "title": "Source",
      "type": "string"
    },
    "installed_at": {
      "format": "date-time",
      "title": "Installed At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "plugin_id",
    "release_version",
    "state",
    "artifact_sha256"
  ],
  "title": "PluginInstallation",
  "type": "object",
  "$id": "https://investment-steward.local/schemas/plugin-installation/1.0"
}
