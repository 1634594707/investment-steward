# ===========================================================================
# Investment Steward 忽略规则
# 原则：可再生成的产物、本机密钥、私人数据不入库；源码/配置/契约产物一律入库。
# 否定规则（!）必须写在其父级规则之后，否则不生效。
# ===========================================================================

# --- 依赖与通用构建产物 ----------------------------------------------------
node_modules/
.venv/
dist/
build/
coverage/
artifacts/
reports/
*.tsbuildinfo

# --- 桌面端打包产物（electron-builder / PyInstaller）----------------------
# dist-desktop*/ 覆盖 dist-desktop、dist-desktop2、dist-desktop-20261026 等历史与按日期命名的输出目录
dist-desktop*/
apps/desktop-host/build*/
apps/desktop-host/dist*/
# tools/ 下只保留 *.spec、hooks/、sidecar_entry.py
apps/desktop-host/tools/build*/
apps/desktop-host/tools/dist*/

# --- Android 构建中间产物（源文件保留在 mobile/www）------------------------
/mobile/android/assets/
/mobile/android/assets_tmp/
/mobile/android/src/com/investment/steward/mobile/EmbeddedPage.java
/mobile/.gradle/
/mobile/local.properties
/mobile/**/*.apk
/mobile/**/*.aab
/mobile/**/*.dex
/mobile/**/*.class

# --- Python 缓存与测试临时目录 --------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.uv-cache/
apps/core-api/tmp*/
apps/core-api/pytest-of-*/
apps/core-api/tests/fixtures/*.bak-*/

# 脚本用 tempfile.mkdtemp 建的临时数据目录：TEMP 未继承时回落到当前目录，
# Windows 下 SQLite 未关闭会让删除失败而残留（详见 scripts/export_contracts.py）
contracts-????????/
route-inventory-????????/

# --- 运行期数据、日志与本地工作目录 ---------------------------------------
.local-data/
.collab-locks/
# Core 以 cwd 为基准的相对数据目录（旧版脚本在 apps/core-api 下跑出来的库）
apps/core-api/.data/
.runtime-*/
**/.runtime/
.tmp_*.json
.tmp-pytest*
.pytest-tmp*
.tmp-verify-data/
_tmp_*
.cleanup-trash/
.recovery-*/
/logs/
*.log

# --- 环境变量 --------------------------------------------------------------
.env
.env.*
!.env.example

# --- 数据库 ----------------------------------------------------------------
*.sqlite3
*.sqlite3-*

# --- 密钥与凭据 ------------------------------------------------------------
# 插件签名：仅公钥入库，私钥本地生成不得提交
apps/core-api/keys/*.pem
!apps/core-api/keys/*.pub.pem
# 移动端签名密钥与口令
*.keystore
*.jks
*.p12
*.pfx
mobile/.env.local
# 中继部署凭据
scripts/relay_bootstrap_token.txt
scripts/relay-app.tar.gz

# --- 本地备份（database snapshot / 遗留私钥备份）不入库 --------------------
backups/

# --- 内部过程文档与证据归档（仅本地保留）-----------------------------------
# docs 下入库的只有：docs/index.html、docs/assets 顶层演示素材、docs/architecture 架构图
docs/*.md
docs/**/*.md
docs/evidence/
docs/perf/
# docs/assets 的子目录都是按日期归档的截图证据（history-audit / icon-* 等）
docs/assets/*/
# archify 等工具生成的隐藏交付目录
docs/architecture/.archify-*/
# 视觉验收报告/截图与历史路由快照不属于 Pages 发布内容；HTML 和规格源保留。
/docs/architecture/*.visual-check.*
/docs/architecture/route-inventory*.json

# --- AI 工具目录（本机安装产物）-------------------------------------------
# 其它 AI 工具的本机忽略清单：仓库只认 .gitignore，别让它入库
.zcodeignore
.codebuddy/
.claude/
.cursor/
# 本机工具配置与分发副本不入库，团队技能源保留在 .teamai/skills/
/.codex/
# WorkBuddy 本机接入配置同样仅在本地保存。
/.workbuddy/
.workbuddy-ai/

# Internal decision notes follow the local-only process-document policy.
.agents/notes/
