  "cards": [
    {
      "dot": "rose",
      "title": "信任边界与归属",
      "items": [
        "令牌 randomBytes(32) 只在主进程，渲染层拿不到密钥",
        "217/220 路由比对 X-Core-Session-Token，仅 /health 免鉴权",
        "桥路径白名单 ~110 条，check:bridge 是打包硬门禁"
      ]
    },
    {
      "dot": "cyan",
      "title": "主链路：一份研报",
      "items": [
        "host:core-request 校验路径并注入令牌",
        "逐源失败写进 source_errors，不留空不臆测",
        "call_active_model 单次阻塞，stream=False"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖",
      "items": [
        "行情公告：东方财富 · 腾讯 · 新浪",
        "宏观商品：FRED · 世行 · OKX · 中金所",
        "模型：任意 OpenAI 兼容端点，密钥进凭据管理器"
      ]
    },
    {
      "dot": "violet",
      "title": "受限执行",
      "items": [
        "清单走 Ed25519 校验，拒收 unsigned fixture",
        "一次性子进程 + PEP 578，封 open/socket/fork",
        "30s 强杀；自陈非容器级隔离"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据落点",
      "items": [
        "steward.sqlite3 45 表 · WAL，手管 user_version 31",
        "macro_cache 12h/7d，排除在导出与同步之外",
        "/export/all 默认不含密钥与设备态"
      ]
    },
    {
      "dot": "slate",
      "title": "休眠面与偏差",
      "items": [
        "relay 不被桌面端拉起，未配置 /sync 即 409",
        "core 不直连 runner，插件引擎在内核内直跑",
        "httpx 只在 sync_client 用，却仅声明为 dev 依赖"
      ]
    }
  ]
